# BEGIN Tegia Seguridad
# Bloquea archivos sensibles o sobrantes: registros, copias, ejemplos y archivos de información.
<FilesMatch "(^error_log|\.log$|\.bak$|\.bk$|^\.htaccess|_original$|^readme\.html$|^license\.txt$|^wp-config-sample\.php$|^default\.php$)">
    Require all denied
</FilesMatch>
# Bloquea XML-RPC (no se usa; es vía común de ataques de fuerza bruta).
<Files "xmlrpc.php">
    Require all denied
</Files>
# Sin listado de directorios.
Options -Indexes
# Cabeceras de seguridad.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
# END Tegia Seguridad

